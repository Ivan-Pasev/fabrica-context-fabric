  "capability_allowlist": [
    "read.drive",
    "analyze.local",
    "verify.local",
    "write.staging",
    "none"
  ],
  "operational_capability_available": "DISCOVER_AT_RUNTIME",
  "no_effect_claims": [
    "agent_role_is_logical",
    "tool_access_is_not_implied",
    "staging_is_not_canonical",
    "synthetic_http_test_is_not_openviking_runtime"
  ],
  "fail_closed": true
}
