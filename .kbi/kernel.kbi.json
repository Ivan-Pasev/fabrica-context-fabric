    {
      "id": "redteam",
      "namespace": "KBI_EPISTEMIC",
      "class": "EPISTEMIC",
      "operation": "REVIEW",
      "required_capability": "analyze.local",
      "output_type": "report.adversarial",
      "depends_on": [
        "synthesize"
      ],
      "invariants": [
        "KBI-EVIDENCE",
        "KBI-CONFLICT"
      ],
      "effect": "NONE",
      "default_decision": "HOLD"
    },
    {
      "id": "verify",
      "namespace": "KBI_EPISTEMIC",
      "class": "EPISTEMIC",
      "operation": "VALIDATE",
      "required_capability": "verify.local",
      "output_type": "report.validation",
      "depends_on": [
        "redteam"
      ],
      "invariants": [
        "KBI-VERIFY"
      ],
      "effect": "NONE",
      "default_decision": "HOLD"
    },
    {
      "id": "review",
      "namespace": "KBI_KERNEL",
      "class": "GOVERNANCE",
      "operation": "APPROVAL_REQUEST",
      "required_capability": "none",
      "output_type": "decision.request",
      "depends_on": [
        "verify"
      ],
      "invariants": [
        "KBI-HUMAN"
      ],
      "effect": "NONE",
      "default_decision": "HOLD"
    },
    {
      "id": "update_handoff",
      "namespace": "KBI_KERNEL",
      "class": "GOVERNANCE",
      "operation": "WRITE_PROPOSAL",
      "required_capability": "write.staging",
      "output_type": "handoff.proposal",
      "depends_on": [
        "review"
      ],
      "invariants": [
        "KBI-DRIFT"
      ],
      "effect": "STAGING_ONLY",
      "default_decision": "HOLD"
    },
    {
      "id": "publish_candidate",
      "namespace": "KBI_KERNEL",
      "class": "RELEASE",
      "operation": "RELEASE_PROPOSAL",
      "required_capability": "write.staging",
      "output_type": "release.candidate",
      "depends_on": [
        "update_handoff"
      ],
      "invariants": [
        "KBI-RELEASE"
      ],
      "effect": "STAGING_ONLY",
      "default_decision": "HOLD"
