{
  "schema": "fcf.kbi.kernel.v1",
  "id": "FCF.KBI.ROOT",
  "project_id": "fcf-research",
  "version": "0.4.0",
  "canonical_root": "https://drive.google.com/drive/folders/PROJECT_FOLDER_ID_REDACTED",
  "type": "PROJECT_BOUND_CAPSULE",
  "default_mode": "AUDIT_ONLY",
  "namespaces": {
    "KBI_KERNEL": "Bounded planning, invariant-guarded execution and transition assessment",
    "KBI_EPISTEMIC": "Claim/evidence/contradiction and promotion-debt assessment"
  },
  "hard_invariants": [
    "KBI-LIVE-CANON",
    "KBI-SOURCE",
    "KBI-EVIDENCE",
    "KBI-BOUNDARY",
    "KBI-DRIFT",
    "KBI-PROVENANCE",
    "KBI-CONFLICT",
    "KBI-VERIFY",
    "KBI-HUMAN",
    "KBI-RELEASE",
    "KBI-ROUTE"
  ],
  "kernels": [
    {
      "id": "sense",
      "namespace": "KBI_KERNEL",
      "class": "SOURCE",
      "operation": "READ",
      "required_capability": "read.drive",
      "output_type": "report.observations",
      "depends_on": [],
      "invariants": [
        "KBI-SOURCE",
        "KBI-LIVE-CANON"
      ],
      "effect": "NONE",
      "default_decision": "HOLD"
    },
    {
      "id": "classify",
      "namespace": "KBI_EPISTEMIC",
      "class": "EPISTEMIC",
      "operation": "ANALYZE",
      "required_capability": "analyze.local",
      "output_type": "report.claims",
      "depends_on": [
        "sense"
      ],
      "invariants": [
        "KBI-EVIDENCE"
      ],
      "effect": "NONE",
      "default_decision": "HOLD"
    },
    {
      "id": "route",
      "namespace": "KBI_KERNEL",
      "class": "KERNEL",
      "operation": "PLAN",
      "required_capability": "analyze.local",
      "output_type": "plan.routing",
      "depends_on": [
        "classify"
      ],
      "invariants": [
        "KBI-ROUTE"
      ],
      "effect": "NONE",
      "default_decision": "HOLD"
    },
    {
      "id": "synthesize",
      "namespace": "KBI_KERNEL",
      "class": "KERNEL",
      "operation": "PROPOSE",
      "required_capability": "write.staging",
      "output_type": "artifact.candidate",
      "depends_on": [
        "route"
      ],
      "invariants": [
        "KBI-BOUNDARY",
        "KBI-PROVENANCE"
