{
  "schema": "fcf.kbi.promotion.v1",
  "project_id": "fcf-research",
  "gates": {
    "CANONICAL_DOC_EDIT": {
      "default": "HOLD",
      "required": [
        "live_revision_read",
        "project_scope",
        "explicit_authorization",
        "diff_review",
        "evidence_trace",
        "revision_guard"
      ],
      "enabled_by_this_package": false
    },
    "GITHUB_RELEASE": {
      "default": "HOLD",
      "required": [
        "repository_exists",
        "permission_verified",
        "license_review",
        "all_local_tests_pass",
        "no_secrets",
        "public_documentation_review",
        "human_release_authorization",
        "remote_ci_status"
      ],
      "enabled_by_this_package": false
    },
    "LIVE_OPENVIKING": {
      "default": "HOLD",
      "required": [
        "v0.5.0_runtime_attested",
        "synthetic_fixture_verified",
        "two_user_isolation",
        "index_consistency",
        "recovery_test"
      ],
      "enabled_by_this_package": false
    }
  },
  "status_vocabulary": [
    "PASS",
    "FAIL",
    "HOLD",
    "UNKNOWN",
    "UNRESOLVED"
  ],
  "evidence_axes": [
    "E0_ASSERTION",
    "E1_REFERENCED",
    "E2_MECHANICALLY_VERIFIED",
    "E3_INDEPENDENTLY_REPRODUCED",
    "E4_CONTENT_ADDRESSED",
    "E5_EXTERNALLY_ATTESTED"
  ],
  "evidence_levels_are_independent_axes": true,
  "publication_is_separate_authority": true
}
