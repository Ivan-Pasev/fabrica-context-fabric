{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "$id": "https://schemas.fabrica.local/fcf.source.v1.json",
  "title": "FCF observed source snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "source_system",
    "source_uri",
    "source_revision",
    "mime_type",
    "content_sha256",
    "content_bytes",
    "observed_at",
    "state",
    "source_authenticity",
    "semantic_truth",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "fcf.source.v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "source_system": {
      "enum": [
        "github",
        "google_drive",
        "local_fixture"
      ]
    },
    "source_uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mime_type": {
      "type": "string",
      "maxLength": 100,
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "const": "OBSERVED"
    },
    "source_authenticity": {
      "const": "NOT_VERIFIED"
    },
    "semantic_truth": {
      "const": "NOT_PROVEN"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
