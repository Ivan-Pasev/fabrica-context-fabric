{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "$id": "https://schemas.fabrica.local/fcf.proposal.v1.json",
  "title": "Untrusted proposed memory",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "claim",
    "source_record_sha256",
    "conflict_keys",
    "state",
    "authority",
    "semantic_truth",
    "proposal_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "fcf.proposal.v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "source_record_sha256": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "conflict_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "state": {
      "const": "PROPOSED"
    },
    "authority": {
      "const": "NONE"
    },
    "semantic_truth": {
      "const": "NOT_PROVEN"
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
